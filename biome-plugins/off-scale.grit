language js(typescript, jsx)

// A class list with a value that is not on the design scale (src/styles/theme.css): an arbitrary size, a hex
// colour or a half step. The same rule tests/unit/tokens.test.ts enforces, shown as you type. A value that cannot
// be on the scale (geometry traced on a photo) says why on the line above: `// off-scale: <reason>`.
`$s` where {
  $s <: r"[\"'`].*(?:-\[[^\]]*[0-9](?:px|rem|em|%|vh|vw|svh|dvh|ms)[^\]]*\]|\[#[0-9a-fA-F]{3,8}\]|[\s\"'`][a-z][a-z-]*-[0-9]+\.5[\s\"'`]).*[\"'`]",
  register_diagnostic(span=$s, message="Off-scale value in a class list: use a token of theme.css (sizes, colours, radii, shadows) or a whole step of the grid; if it cannot be on the scale, say why on the line above (// off-scale: <reason>).")
}
