{
  "name": "msmt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsx scripts/prebuild.ts && vite build",
    "build:hreflang": "tsx scripts/build-hreflang.ts",
    "preview": "vite preview",
    "serve:dist": "tsx scripts/serve-dist.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm gen:routes && pnpm build:hreflang && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:seo": "vitest run --project seo",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project visual",
    "lhci": "lhci autorun",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "release-check": "pnpm check && pnpm test:storybook && SITE_LOCALE=en pnpm build && pnpm test:seo",
    "prebuild_only": "tsx scripts/prebuild.ts",
    "check:slugs": "tsx scripts/check-slugs.ts",
    "gen:routes": "tsx scripts/generate-routes.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@netlify/blobs": "^11.1.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource/montserrat": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/rollup": "^3.1.1",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "^1.167.40",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "cheerio": "^1.2.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "playwright": "^1.63.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "satori": "^0.36.0",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@resvg/resvg-js"
    ]
  }
}
