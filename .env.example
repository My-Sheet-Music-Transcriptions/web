# Which locale site this build produces (en | es | fr | de | ja | ca)
SITE_LOCALE=en
# Outgoing mail (contact forms and shop) through Mailgun. Leave the key empty locally to log instead of sending.
# A domain sending key, the verified sending domain and its region (eu or us).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=eu
CONTACT_TO_EMAIL=info@mysheetmusictranscriptions.com
CONTACT_FROM_EMAIL=website@mysheetmusictranscriptions.com
# Google Tag Manager container, loaded only after consent
VITE_GTM_ID=
# Secrets are committed encrypted in .env.development / .env.production (dotenvx; see CLAUDE.md, "Secrets").
# A plain .env (this file's names) overrides them locally.
# Shop (Stripe, paid in the cart's panel). Without STRIPE_SECRET_KEY checkout runs in demo mode (orders without payment); SHOP_DEMO=off refuses instead.
STRIPE_SECRET_KEY=
# The publishable key of the same account: the browser loads Stripe's payment element with it.
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook https://<site>/api/shop/stripe-webhook (event checkout.session.completed)
STRIPE_WEBHOOK_SECRET=
# Where new orders are announced (defaults to CONTACT_TO_EMAIL) and who the customer emails come from
SHOP_ORDERS_EMAIL=
SHOP_FROM_EMAIL=
# Comma-separated emails allowed in /admin/orders besides Netlify Identity users with the shop or admin role
SHOP_ADMIN_EMAILS=
SHOP_DEMO=
